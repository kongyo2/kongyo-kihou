{
  "name": "kongyo-kihou",
  "displayName": "kongyo記法",
  "description": "事前の言い訳を構文で落とす。予測を書いた瞬間に判定可能性を検査し、確定した行を書き換え不能にするリアルタイム記述拘束。",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "kongyo2",
  "private": true,
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=20.18.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "kongyo",
    "prediction",
    "forecasting",
    "brier",
    "calibration",
    "予測",
    "記法"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kongyo2/kongyo-kihou.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:kongyo",
    "onLanguage:markdown",
    "onLanguage:plaintext"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kongyo",
        "aliases": [
          "kongyo記法",
          "kongyo"
        ],
        "extensions": [
          ".kongyo",
          ".kgy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kongyo",
        "scopeName": "source.kongyo",
        "path": "./syntaxes/kongyo.tmLanguage.json"
      },
      {
        "scopeName": "markdown.kongyo.codeblock",
        "path": "./syntaxes/kongyo.markdown-injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.kongyo": "kongyo"
        }
      }
    ],
    "commands": [
      {
        "command": "kongyo.cast",
        "title": "予測を鋳造する（ウィザード）",
        "category": "kongyo",
        "icon": "$(law)"
      },
      {
        "command": "kongyo.commitLine",
        "title": "現在行を確定して台帳へ追記",
        "category": "kongyo",
        "icon": "$(check-all)"
      },
      {
        "command": "kongyo.judge",
        "title": "判定日が来た予測を判定する",
        "category": "kongyo",
        "icon": "$(law)"
      },
      {
        "command": "kongyo.judgeLine",
        "title": "この行を判定する",
        "category": "kongyo"
      },
      {
        "command": "kongyo.tally",
        "title": "集計を表示する（× ／ － ／ ブライアスコア）",
        "category": "kongyo",
        "icon": "$(graph)"
      },
      {
        "command": "kongyo.openLedger",
        "title": "台帳を開く",
        "category": "kongyo",
        "icon": "$(book)"
      },
      {
        "command": "kongyo.openInventory",
        "title": "未形式化在庫を開く",
        "category": "kongyo"
      },
      {
        "command": "kongyo.toInventory",
        "title": "未形式化在庫へ落とす",
        "category": "kongyo",
        "icon": "$(archive)"
      },
      {
        "command": "kongyo.unlockLine",
        "title": "この行の拘束を一時解除する（解除は台帳に記録される）",
        "category": "kongyo",
        "icon": "$(unlock)"
      },
      {
        "command": "kongyo.showRules",
        "title": "記法の規則を表示する",
        "category": "kongyo",
        "icon": "$(book)"
      }
    ],
    "keybindings": [
      {
        "command": "kongyo.cast",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "kongyo.commitLine",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == kongyo"
      },
      {
        "command": "kongyo.toInventory",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorLangId == kongyo"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kongyo.cast",
          "group": "kongyo@1",
          "when": "editorTextFocus"
        },
        {
          "command": "kongyo.commitLine",
          "group": "kongyo@2",
          "when": "editorLangId == kongyo"
        },
        {
          "command": "kongyo.toInventory",
          "group": "kongyo@3",
          "when": "editorLangId == kongyo"
        },
        {
          "command": "kongyo.unlockLine",
          "group": "kongyo@4",
          "when": "editorLangId == kongyo"
        }
      ],
      "editor/title": [
        {
          "command": "kongyo.judge",
          "group": "navigation@1",
          "when": "editorLangId == kongyo"
        },
        {
          "command": "kongyo.tally",
          "group": "navigation@2",
          "when": "editorLangId == kongyo"
        }
      ],
      "commandPalette": [
        {
          "command": "kongyo.judgeLine",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "kongyo記法",
      "properties": {
        "kongyo.ledger.path": {
          "type": "string",
          "default": "kongyo/予測台帳.kongyo",
          "markdownDescription": "台帳ファイルのパス。ワークスペース相対。ワークスペースが無い場合は拡張のグローバル保存領域に置かれる。"
        },
        "kongyo.inventory.path": {
          "type": "string",
          "default": "kongyo/未形式化在庫.md",
          "markdownDescription": "未形式化在庫ファイルのパス。ワークスペース相対。§7 のとおり、鋳造できなかった文を原文のまま落とす先。"
        },
        "kongyo.ledger.guard": {
          "type": "string",
          "enum": [
            "revert",
            "warn",
            "off"
          ],
          "enumDescriptions": [
            "確定行の本文への編集を即座に差し戻す（§6「追記のみ。編集不可」）",
            "差し戻さず警告のみ出す",
            "何もしない"
          ],
          "default": "revert",
          "markdownDescription": "確定済み（`[YYYY-MM-DD]` の刻印を持ち、保存済み）の行に対する編集の扱い。末尾の判定記号の置換は常に許可される。"
        },
        "kongyo.diagnostics.delay": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 2000,
          "markdownDescription": "打鍵から検査までの遅延（ミリ秒）。0 で完全にリアルタイム。"
        },
        "kongyo.markdown.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Markdown / プレーンテキスト内の kongyo フェンス（``` kongyo）も検査する。"
        },
        "kongyo.vocabulary.enforcement": {
          "type": "string",
          "enum": [
            "oc",
            "all"
          ],
          "enumDescriptions": [
            "§5 のとおり O・C 欄のみ却下、他欄は警告",
            "全欄で却下する"
          ],
          "default": "oc",
          "markdownDescription": "禁止語彙（§5）の適用範囲。"
        },
        "kongyo.vocabulary.additional": {
          "type": "array",
          "default": [],
          "markdownDescription": "禁止語彙の追加。`pattern` は JavaScript 正規表現のソース。",
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "replacement"
            ],
            "properties": {
              "pattern": {
                "type": "string"
              },
              "replacement": {
                "type": "string"
              },
              "fixText": {
                "type": "string"
              }
            }
          }
        },
        "kongyo.checks.c2.selfPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "C2（外部判定）で自判とみなす語の追加。既定の一覧に追加される。"
        },
        "kongyo.checks.c2.discretionPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "C2 で裁量とみなす語の追加。"
        },
        "kongyo.checks.c2.procedurePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "C2 で「固定された判定手順」とみなす語の追加。`J` が自分でも、この語を含めば通る。"
        },
        "kongyo.checks.c7.rewriteVerbs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "C7（停止条件）で具体的な書き換えとみなす語の追加。"
        },
        "kongyo.checks.c7.requireRewriteVerb": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "`R` に書き換え動詞を必須にする。off にすると禁止語の検出のみになる。"
        },
        "kongyo.checks.c3.requireDefiniteCondition": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "`C` に数値・比較・状態リテラルのいずれかを必須にする（C3 反証形の機械的な近似）。"
        },
        "kongyo.checks.c8.autoInsertEasyMarker": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "確定時に `p ≥ 0.90` / `p ≤ 0.10` の行へ `[易]` を自動で付す。"
        },
        "kongyo.decorations.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "禁止語彙に打ち消し線を引く。"
        },
        "kongyo.inlayHints.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "行末に欠落している必須項を表示する。"
        },
        "kongyo.codeLens.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "確定・判定・在庫送りの CodeLens を表示する。"
        },
        "kongyo.statusBar.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "ステータスバーに `×` `－` の絶対数とブライアスコアを表示する。§6 のとおり `○` の数は表示しない。"
        }
      }
    },
    "colors": [
      {
        "id": "kongyo.sealedLineBackground",
        "description": "確定した予測の行の背景。ここから先は書き換えられない。",
        "defaults": {
          "dark": "#ffffff0d",
          "light": "#0000000d",
          "highContrast": "#ffffff1a",
          "highContrastLight": "#0000001a"
        }
      },
      {
        "id": "kongyo.dueLineBorder",
        "description": "判定期日が到来した行の枠。",
        "defaults": {
          "dark": "#e2b93d",
          "light": "#9a6d00",
          "highContrast": "#e2b93d",
          "highContrastLight": "#9a6d00"
        }
      }
    ],
    "configurationDefaults": {
      "[kongyo]": {
        "editor.wordWrap": "on",
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": false,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "watch": "node scripts/build.mts --watch",
    "probe": "node scripts/build.mts && node scripts/probe.mts",
    "typecheck": "tsc --noEmit --pretty false --checkers 4",
    "typecheck:watch": "tsc --noEmit --watch --pretty false --checkers 4",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false --checkers 4",
    "typecheck:test:ci": "tsc -p tsconfig.test.json --skipLibCheck false --incremental false --pretty false --checkers 4",
    "typecheck:ci": "tsc -p tsconfig.ci.json --pretty false --checkers 4",
    "check:decl": "tsc -p tsconfig.declarations.json --pretty false --checkers 4",
    "lint": "oxlint --format agent",
    "lint:fix": "oxlint --fix",
    "lint:strict": "oxlint --deny-warnings",
    "lint:types": "oxlint --type-aware --type-check --tsconfig tsconfig.ci.json --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mts --production",
    "gate": "npm run format:check && npm run lint:strict && npm run typecheck:ci && npm run typecheck:test:ci && npm run check:decl && npm run lint:types && npm run test && npm run probe"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
